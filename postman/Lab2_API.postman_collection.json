        {
          "name": "Create Function",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const userId = pm.collectionVariables.get('userId');",
                  "if (!userId) {",
                  "    throw new Error('userId is not defined. Run Create User before Create Function.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time under 1000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "pm.test(\"Function created successfully\", function () {",
                  "    pm.expect(jsonData).to.have.property('success', true);",
                  "    pm.expect(jsonData.data).to.have.property('functionId');",
                  "    pm.expect(jsonData.data).to.have.property('userId');",
                  "    pm.expect(jsonData.data).to.have.property('expression');",
                  "});",
                  "",
                  "if (jsonData.data && jsonData.data.functionId) {",
                  "    pm.collectionVariables.set('functionId', jsonData.data.functionId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Quadratic {{uniqueSuffix}}\",\n    \"expression\": \"x^2 + 3x + 2\",\n    \"userId\": {{userId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/functions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "functions"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Functions By User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const userId = pm.collectionVariables.get('userId');",
                  "if (!userId) {",
                  "    throw new Error('userId is not defined. Run Create User first.');",
                  "}",
                  "pm.variables.set('pathUserId', userId);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "const expectedUserId = Number(pm.collectionVariables.get('userId')) || null;",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time under 1000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "pm.test(\"All functions belong to the requested user\", function () {",
                  "    pm.expect(jsonData).to.have.property('success', true);",
                  "    if (Array.isArray(jsonData.data)) {",
                  "        jsonData.data.forEach(fn => {",
                  "            pm.expect(fn.userId).to.eql(expectedUserId);",
                  "        });",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/functions/user/{{pathUserId}}",
