                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{uniqueUsername}}\",\n    \"email\": \"{{uniqueEmail}}\",\n    \"password\": \"P@ssw0rd123\"\n}"
