<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Math Functions API</display-name>

    <!-- User Servlet -->
    <servlet>
        <servlet-name>UserServlet</servlet-name>
        <servlet-class>API.servlets.UserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/api/v1/users/*</url-pattern>
    </servlet-mapping>

    <!-- Function Servlet -->
    <servlet>
        <servlet-name>FunctionServlet</servlet-name>
        <servlet-class>API.servlets.FunctionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FunctionServlet</servlet-name>
        <url-pattern>/api/v1/functions/*</url-pattern>
    </servlet-mapping>

    <!-- Point Servlet -->
    <servlet>
        <servlet-name>PointServlet</servlet-name>
        <servlet-class>API.servlets.PointServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PointServlet</servlet-name>
        <url-pattern>/api/v1/points/*</url-pattern>
    </servlet-mapping>

</web-app>